         parsing, the C64 emulation, utility code, and the residfp-builder
         bridge. Other builders (exsid/sidlite/usbsid) and tests are excluded. -->
    <ClCompile Include="src\*.cpp" />
    <ClCompile Include="src\sidplayfp\*.cpp" />
    <ClCompile Include="src\sidtune\*.cpp" />
    <ClCompile Include="src\c64\**\*.cpp" />
    <ClCompile Include="src\utils\**\*.cpp" />
    <ClCompile Include="src\builders\residfp-builder\*.cpp" />
  </ItemGroup>
